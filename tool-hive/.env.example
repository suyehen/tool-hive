# ToolHive 参考用的环境变量
# 复制到 .env 并修改
# 配置优先级：环境变量具体值 > 外挂 YAML > .env 文件 > 代码默认值。

# ── 应用 ──
TOOLHIVE_DEBUG=false

# ── 外挂配置（可选）：指定 YAML 配置文件路径 ──
# TOOLHIVE_CONFIG_FILE=/vdb/tool-hive/config/production.yaml

# ── 监听（A01：单一应用、单一端口，仅绑定回环地址） ──
TOOLHIVE_BIND_HOST=127.0.0.1
TOOLHIVE_BIND_PORT=8100

# ── 数据库 ──
TOOLHIVE_DATABASE_URL=postgresql+asyncpg://toolhive:changeme@localhost:5432/toolhive

# ── Redis / 共享缓存 ──
TOOLHIVE_REDIS_URL=redis://localhost:6379/0

# ── Chroma ──
TOOLHIVE_CHROMA_MODE=embedded
TOOLHIVE_CHROMA_PERSIST_DIRECTORY=./chroma_data

# ── 网络入口 ──
TOOLHIVE_NETWORK_TRUSTED_PROXIES=["127.0.0.1/32","::1/128"]
TOOLHIVE_NETWORK_ALLOW_LOOPBACK_DIRECT=false

# ── Outbox 后台投递任务 ──
TOOLHIVE_OUTBOX_ENABLED=true
TOOLHIVE_OUTBOX_POLL_INTERVAL_MS=1000
TOOLHIVE_OUTBOX_BATCH_SIZE=50
TOOLHIVE_OUTBOX_MAX_CONCURRENCY=5
TOOLHIVE_OUTBOX_LOCK_TIMEOUT_SECONDS=60

# ── 雪花算法 ID ──
TOOLHIVE_SNOWFLAKE_DATACENTER_ID=1
TOOLHIVE_SNOWFLAKE_WORKER_ID=0

# ── 模型服务 ──
TOOLHIVE_MODEL_API_KEY=
TOOLHIVE_EMBEDDING_MODEL=

# ── 安全参数（均可配置，保留默认值即可） ──
TOOLHIVE_LOGIN_MAX_FAILURES=5
TOOLHIVE_LOGIN_LOCK_MINUTES=30
TOOLHIVE_LOGIN_FAILURE_WINDOW_MINUTES=10
TOOLHIVE_CAPTCHA_TTL_SECONDS=300
TOOLHIVE_CAPTCHA_CODE_LENGTH=4
TOOLHIVE_SESSION_IDLE_TIMEOUT_MINUTES=30
TOOLHIVE_SESSION_ABSOLUTE_TIMEOUT_HOURS=8
TOOLHIVE_TEMP_PASSWORD_EXPIRE_HOURS=24
TOOLHIVE_PASSWORD_MIN_LENGTH=12
TOOLHIVE_PASSWORD_MAX_LENGTH=128
TOOLHIVE_PASSWORD_HISTORY_COUNT=5
TOOLHIVE_SIGNATURE_TIME_WINDOW_SECONDS=300
TOOLHIVE_NONCE_RETENTION_MINUTES=10
TOOLHIVE_SIGNING_KEY_MIN_BITS=2048
TOOLHIVE_SIGNING_ALGORITHM=RSA-PSS-SHA256
TOOLHIVE_SIGNATURE_VERSION=TOOLHIVE-SIGN-V1
TOOLHIVE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
TOOLHIVE_CIRCUIT_BREAKER_WINDOW_SECONDS=60
TOOLHIVE_CIRCUIT_BREAKER_OPEN_SECONDS=30
TOOLHIVE_PROVIDER_MAX_RESPONSE_BYTES=1048576
TOOLHIVE_PROVIDER_MAX_HEADER_COUNT=50
TOOLHIVE_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
TOOLHIVE_RETRIEVAL_TIMEOUT_SECONDS=10

# ── 密钥（生产环境务必修改） ──
TOOLHIVE_CSRF_SECRET=
