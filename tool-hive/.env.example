# ToolHive 参考用的环境变量
# 复制到 .env 并修改

# ── 应用 ──
TOOLHIVE_DEBUG=false

# ── 运行面（内网） ──
TOOLHIVE_RUNTIME_HOST=127.0.0.1
TOOLHIVE_RUNTIME_PORT=8100

# ── 管理面（公网） ──
TOOLHIVE_MANAGEMENT_HOST=0.0.0.0
TOOLHIVE_MANAGEMENT_PORT=8101

# ── 数据库 ──
TOOLHIVE_DATABASE_URL=postgresql+asyncpg://toolhive:changeme@localhost:5432/toolhive

# ── Redis / 共享缓存 ──
TOOLHIVE_REDIS_URL=redis://localhost:6379/0

# ── Chroma ──
TOOLHIVE_CHROMA_PERSIST_DIR=./chroma_data

# ── 模型服务 ──
TOOLHIVE_MODEL_API_KEY=
TOOLHIVE_EMBEDDING_MODEL=

# ── 安全参数（均可配置，保留默认值即可） ──
TOOLHIVE_LOGIN_MAX_FAILURES=5
TOOLHIVE_LOGIN_LOCK_MINUTES=30
TOOLHIVE_CAPTCHA_TRIGGER_FAILURES=3
TOOLHIVE_CAPTCHA_TRIGGER_WINDOW_MINUTES=10
TOOLHIVE_SESSION_IDLE_TIMEOUT_MINUTES=30
TOOLHIVE_SESSION_ABSOLUTE_TIMEOUT_HOURS=8
TOOLHIVE_TEMP_PASSWORD_EXPIRE_HOURS=24
TOOLHIVE_PASSWORD_MIN_LENGTH=12
TOOLHIVE_PASSWORD_MAX_LENGTH=128
TOOLHIVE_PASSWORD_HISTORY_COUNT=5
TOOLHIVE_SIGNATURE_TIME_WINDOW_SECONDS=300
TOOLHIVE_NONCE_RETENTION_MINUTES=10
TOOLHIVE_SIGNING_KEY_MIN_BITS=2048
TOOLHIVE_SIGNING_ALGORITHM=RSA-PSS-SHA256
TOOLHIVE_SIGNATURE_VERSION=TOOLHIVE-SIGN-V1

# ── 密钥（生产环境务必修改） ──
TOOLHIVE_TOTP_ENCRYPTION_KEY=
TOOLHIVE_CSRF_SECRET=
