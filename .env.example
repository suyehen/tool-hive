# ToolHive 环境变量
# 复制到 .env 并修改

# 应用
TOOLHIVE_DEBUG=true

# 数据库
TOOLHIVE_DATABASE_URL=postgresql+asyncpg://toolhive:toolhive@localhost:5432/toolhive

# 密钥（生产环境请用 openssl rand -hex 32 生成）
TOOLHIVE_SECRET_KEY=change-me-in-production

# Chroma
TOOLHIVE_CHROMA_HOST=localhost
TOOLHIVE_CHROMA_PORT=8000

# Redis
TOOLHIVE_REDIS_URL=redis://localhost:6379/0

# 运行面内部密钥
TOOLHIVE_RUNTIME_API_KEY=change-me-runtime-key
